          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto12" value="接入：所有虚拟机指向同一台 Egress。&lt;br&gt;源地址防伪造没有验证过。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="30" width="310" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="auto13" value="Egress：单点。每台虚拟机每个端口一条过滤链，&lt;br&gt;3 台虚拟机 35 条；改配置要重启 Envoy。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="140" width="310" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auto14" value="网关：同一时刻只有一台工作，吞吐不能叠加。&lt;br&gt;切换时连接全断，实测 1.4 到 3.9 秒恢复。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="270" width="310" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auto15" value="VPN 服务器：单点，&lt;br&gt;也是全部内网流量的吞吐上限。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="400" width="310" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auto16" value="互联网出口：单出口地址，&lt;br&gt;非 TCP 流量不经七层控制直接转发。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="530" width="310" height="50" as="geometry"/>
        </mxCell>
