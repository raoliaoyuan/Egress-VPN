<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="04-access-failover" name="接入分片和 Egress 故障接管">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="a" value="正常" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="460" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="av1" value="&lt;b&gt;块 1、块 2 的虚拟机&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontColor=#222222;" vertex="1" parent="a">
          <mxGeometry x="20" y="40" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="av2" value="&lt;b&gt;块 3 的虚拟机&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontColor=#222222;" vertex="1" parent="a">
          <mxGeometry x="240" y="40" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ar" value="&lt;b&gt;rtr-acc&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;按源地址所在的块选下一跳&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;下一跳是这个块的接入地址&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontColor=#222222;" vertex="1" parent="a">
          <mxGeometry x="80" y="150" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="auto1" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="av1" target="ar">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto2" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="av2" target="ar">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ae1" value="&lt;b&gt;egress-1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;持有块 1、块 2 的接入地址&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="a">
          <mxGeometry x="20" y="290" width="200" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="ae2" value="&lt;b&gt;egress-2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;持有块 3 的接入地址&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="a">
          <mxGeometry x="240" y="290" width="200" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auto3" value="块 1、块 2" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ar" target="ae1">
