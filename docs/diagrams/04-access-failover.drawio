        <mxCell id="be1" value="&lt;b&gt;egress-1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;故障&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontColor=#222222;" vertex="1" parent="b">
          <mxGeometry x="20" y="290" width="200" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="be2" value="&lt;b&gt;egress-2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;三个块的接入地址都在这里&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="b">
          <mxGeometry x="240" y="290" width="200" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auto8" value="块 1、块 2、块 3" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="br" target="be2">
          <mxGeometry relative="1" as="geometry"/>
