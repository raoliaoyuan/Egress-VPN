          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto7" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bv2" target="br">
          <mxGeometry relative="1" as="geometry"/>
