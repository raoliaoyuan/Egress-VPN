        <mxCell id="auto4" value="块 3" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ar" target="ae2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto5" value="每个块只走一台 Egress，去程和回程都经过它。&lt;br&gt;两台 Egress 互为热备，各自预留对方的容量。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="a">
