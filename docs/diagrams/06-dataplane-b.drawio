<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="06-dataplane-b" name="数据面 B：地址转换搬到 Egress，网关只转发">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="vm" value="&lt;b&gt;虚拟机&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;10.1.2.3&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="120" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="eg" value="&lt;b&gt;Egress&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Envoy：劫持、注入凭证&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;内核换源地址&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="230" y="40" width="160" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="gw" value="&lt;b&gt;VPN 网关&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;只做路由和隧道&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;不记连接&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="480" y="40" width="160" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="vs" value="&lt;b&gt;VPN 服务器&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;只转发&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="730" y="40" width="110" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="sv" value="&lt;b&gt;内网服务&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;10.200.5.6&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="890" y="40" width="110" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="auto1" value="①" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vm" target="eg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto2" value="②" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eg" target="gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto3" value="③" style="html=1;rounded=0;strokeColor=#9673a6;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="vs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto4" value="④" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vs" target="sv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto5" value="①　虚拟机发出的原始连接&lt;br&gt;源 10.1.2.3&lt;br&gt;目的 10.200.5.6:443" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="150" width="225" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="auto6" value="②　普通的三层报文，没有 PROXY 头&lt;br&gt;源 100.64.0.7（内网 IP）&lt;br&gt;目的 10.200.5.6:443" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="265" y="150" width="225" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="auto7" value="③　隧道内，报文不变&lt;br&gt;源 100.64.0.7&lt;br&gt;目的 10.200.5.6:443" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="510" y="150" width="225" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="auto8" value="④　内网里的普通报文&lt;br&gt;源 100.64.0.7&lt;br&gt;目的 10.200.5.6:443" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="755" y="150" width="225" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="auto9" value="TCP 连接的起止（连接状态存在哪里）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="270" width="300" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="auto10" value="连接一：虚拟机 ↔ Egress" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="304" width="370" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="auto11" value="连接二：Egress ↔ 内网服务（中间的网关和 VPN 服务器只转发报文）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="230" y="344" width="770" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="auto12" value="连接状态只在 Egress 上。网关和 VPN 服务器都不记连接，任何一台故障，报文改走另一台，连接二不中断。&lt;br&gt;多台网关可以同时承载同一个地址块。实验结果（参考实现）：三台网关同时承载一个块，一台断电时长连接全部存活。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="398" width="980" height="46" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
