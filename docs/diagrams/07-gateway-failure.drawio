<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="07-gateway-failure" name="一台网关故障时，两种数据面的差别">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="a" value="数据面 A：按单元单活，gw-3 接管" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="470" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="ae1" value="&lt;b&gt;egress-1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;块 1、块 2&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="a">
          <mxGeometry x="20" y="40" width="205" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ae2" value="&lt;b&gt;egress-2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;块 3&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="a">
          <mxGeometry x="245" y="40" width="205" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ag1" value="&lt;b&gt;gw-1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;故障&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontColor=#222222;" vertex="1" parent="a">
          <mxGeometry x="20" y="190" width="130" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="ag3" value="&lt;b&gt;gw-3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;热备，接管单元 1&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#222222;" vertex="1" parent="a">
          <mxGeometry x="170" y="190" width="130" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="ag2" value="&lt;b&gt;gw-2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;单元 2&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#222222;" vertex="1" parent="a">
          <mxGeometry x="320" y="190" width="130" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auto1" value="单元 1 的服务地址漂到 gw-3" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ae1" target="ag3">
          <mxGeometry relative="1" x="-0.45" as="geometry"/>
        </mxCell>
        <mxCell id="auto2" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ae2" target="ag2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="av" value="&lt;b&gt;VPN 服务器 1、VPN 服务器 2&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontColor=#222222;" vertex="1" parent="a">
          <mxGeometry x="20" y="330" width="430" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="auto3" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ag3" target="av">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto4" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ag2" target="av">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto5" value="块 1、块 2：Egress 到网关、网关到内网的连接全部中断，&lt;br&gt;等 gw-3 接管后重建。块 3 不受影响。&lt;br&gt;实测 3.8 秒恢复；检测间隔调到 0.2 秒是 1.9 秒。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="a">
          <mxGeometry x="20" y="402" width="430" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="b" value="数据面 B：无状态多活，流量改走其余网关" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="510" y="20" width="470" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="be1" value="&lt;b&gt;egress-1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;块 1、块 2&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="b">
          <mxGeometry x="20" y="40" width="205" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="be2" value="&lt;b&gt;egress-2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;块 3&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="b">
          <mxGeometry x="245" y="40" width="205" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="bg1" value="&lt;b&gt;gw-1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;故障&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontColor=#222222;" vertex="1" parent="b">
          <mxGeometry x="20" y="190" width="130" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="bg3" value="&lt;b&gt;gw-3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;转发所有块&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#222222;" vertex="1" parent="b">
          <mxGeometry x="170" y="190" width="130" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="bg2" value="&lt;b&gt;gw-2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;转发所有块&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#222222;" vertex="1" parent="b">
          <mxGeometry x="320" y="190" width="130" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auto6" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;" edge="1" parent="1" source="be1" target="bg3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto7" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;" edge="1" parent="1" source="be1" target="bg2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto8" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;" edge="1" parent="1" source="be2" target="bg3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto9" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;" edge="1" parent="1" source="be2" target="bg2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="bv" value="&lt;b&gt;VPN 服务器 1、VPN 服务器 2&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontColor=#222222;" vertex="1" parent="b">
          <mxGeometry x="20" y="330" width="430" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="auto10" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bg3" target="bv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto11" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bg2" target="bv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto12" value="所有块的报文在剩下的网关之间重新分摊。&lt;br&gt;连接两端是 Egress 和内网服务，网关不记连接，所以连接不断，&lt;br&gt;实测：长连接全部存活，最长卡 1.5 秒；新连接约 1 秒恢复。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="b">
          <mxGeometry x="20" y="402" width="430" height="78" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
