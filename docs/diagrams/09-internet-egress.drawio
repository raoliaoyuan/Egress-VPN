<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="09-internet-egress" name="互联网出口：两种出口模式和 Egress 上的检查">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="vm" value="&lt;b&gt;虚拟机&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;10.1.2.3&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="20" y="180" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="eg" value="一台 Egress" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="190" y="20" width="600" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="cls" value="&lt;b&gt;流量分类&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;按协议和端口&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontColor=#222222;" vertex="1" parent="eg">
          <mxGeometry x="20" y="160" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="tcp" value="&lt;b&gt;TCP：七层处理&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;对指定的服务注入凭证&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;拒绝指向内网地址的域名&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;记访问日志&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="eg">
          <mxGeometry x="190" y="40" width="220" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="dns" value="&lt;b&gt;DNS：只到指定的解析器&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;只解析允许的域名&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;拒绝解析到私有地址&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="eg">
          <mxGeometry x="190" y="150" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="deny" value="&lt;b&gt;其余 UDP、ICMP 等&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;默认拒绝（含 QUIC）&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontColor=#222222;" vertex="1" parent="eg">
          <mxGeometry x="190" y="260" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="mode" value="&lt;b&gt;出口模式&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;按块配置&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;单台可另行指定&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontColor=#222222;" vertex="1" parent="eg">
          <mxGeometry x="450" y="40" width="130" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="pool" value="&lt;b&gt;出口地址池&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;内核换源地址&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;一台虚拟机固定&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;到一个出口地址&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="eg">
          <mxGeometry x="450" y="270" width="130" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="gw" value="&lt;b&gt;VPN 网关&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;换成内网 IP&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="970" y="30" width="150" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="srv" value="&lt;b&gt;VPN 服务器&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;隧道，转发进内网&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="970" y="126" width="150" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="corp" value="&lt;b&gt;企业互联网出口&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;安全管控设备&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;来源是每台的内网 IP&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="970" y="222" width="150" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="inet" value="&lt;b&gt;互联网&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="1180" y="310" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="aud" value="&lt;b&gt;审计：谁、去哪里、何时、放行还是拒绝、用的出口地址&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="380" y="470" width="390" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="auto1" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vm" target="cls">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto2" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cls" target="tcp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto3" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cls" target="dns">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto4" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cls" target="deny">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto5" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tcp" target="mode">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto6" value="经企业出口（默认）" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mode" target="gw">
          <mxGeometry relative="1" y="-12" as="geometry"/>
        </mxCell>
        <mxCell id="auto7" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="srv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto8" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="srv" target="corp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto9" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="corp" target="inet">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto10" value="本地直出（例外）" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mode" target="pool">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto11" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="inet">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto12" value="放行和拒绝都记录" style="html=1;rounded=0;strokeColor=#d79b00;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;dashed=1;exitX=0.64;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="eg" target="aud">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto13" value="去内网的流量也交给&lt;br&gt;VPN 网关，走同一条&lt;br&gt;隧道。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="eg">
          <mxGeometry x="20" y="330" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="auto14" value="经企业出口时，网关、&lt;br&gt;隧道、VPN 服务器要&lt;br&gt;承载全部互联网流量；&lt;br&gt;这条路不通时&lt;br&gt;不自动改成本地直出。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="30" width="160" height="116" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
