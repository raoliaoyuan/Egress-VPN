<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="10-control-plane" name="控制面：一份权威数据，各节点自己拉取">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="tab" value="&lt;b&gt;地址分配表（权威数据）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;虚拟机 · 内网 IP · 所属的块 · 允许的目的地 · 凭证引用&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="320" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="pub" value="&lt;b&gt;配置发布&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;生成整份快照，带版本号和校验值&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="330" y="130" width="320" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auto1" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;" edge="1" parent="1" source="tab" target="pub">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;Egress 上的代理&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;拉取、校验，失败就保留旧的&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;原子替换配置文件，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Envoy 动态加载，不重启&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;网关上的代理&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;拉取、校验，失败就保留旧的&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;整张映射表在一个事务里替换，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;没有中间状态&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="355" y="270" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;VPN 服务器&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;不需要逐台虚拟机下发&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;地址块归谁靠 BGP 通告&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;只有增减网关实例时才改配置&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="670" y="270" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="auto2" value="拉取" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pub" target="a1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto3" value="拉取" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pub" target="a2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto4" value="确认已生效的版本" style="html=1;rounded=0;strokeColor=#d79b00;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;dashed=1;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="pub">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="94" y="162"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="auto5" value="新增一台虚拟机" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="200" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s00" value="一　分配内网 IP" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="212" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s01" value="二　映射下发到网关，等确认" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="268" y="440" width="212" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="auto6" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s00" target="s01">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s02" value="三　凭证和策略下发到 Egress" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="496" y="440" width="212" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="auto7" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s01" target="s02">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s03" value="四　放行" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="724" y="440" width="212" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="auto8" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s02" target="s03">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto9" value="下线一台虚拟机" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="200" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s10" value="一　在 Egress 上拒绝" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="212" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s11" value="二　清掉已有连接" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="268" y="540" width="212" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="auto10" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s10" target="s11">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s12" value="三　删除映射" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="496" y="540" width="212" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="auto11" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s11" target="s12">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s13" value="四　地址隔离一段时间再回收" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#333333;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="724" y="540" width="212" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="auto12" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s12" target="s13">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto13" value="控制面不可用时：各节点沿用最后一份校验通过的配置，已有虚拟机不受影响，只是不能新增和变更。&lt;br&gt;未登记的虚拟机始终被拒绝，不因为控制面故障而放开。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="900" height="46" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
