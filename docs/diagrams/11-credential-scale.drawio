          </mxGeometry>
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;vm-a × 8443&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontColor=#222222;" vertex="1" parent="p1">
          <mxGeometry x="338" y="40" width="96" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="auto2" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="l" target="c1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="115"/>
              <mxPoint x="220" y="126"/>
              <mxPoint x="406" y="126"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;vm-b × 80&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontColor=#222222;" vertex="1" parent="p1">
          <mxGeometry x="446" y="40" width="96" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="auto3" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="l" target="c2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="115"/>
              <mxPoint x="220" y="126"/>
              <mxPoint x="514" y="126"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;vm-b × 8443&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontColor=#222222;" vertex="1" parent="p1">
          <mxGeometry x="554" y="40" width="96" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="auto4" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="l" target="c3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="115"/>
              <mxPoint x="220" y="126"/>
              <mxPoint x="622" y="126"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;……&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontColor=#222222;" vertex="1" parent="p1">
          <mxGeometry x="662" y="40" width="96" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="auto5" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="l" target="c4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="115"/>
              <mxPoint x="220" y="126"/>
              <mxPoint x="730" y="126"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="auto6" value="凭证直接写在每条链的配置里。3 台虚拟机 35 条；&lt;br&gt;十万台是百万条量级，配置的体积和加载时间都不可行。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p1">
          <mxGeometry x="230" y="125" width="530" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="建议：规则按服务写，凭证按身份查" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="240" width="940" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="q1" value="&lt;b&gt;请求进入&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;来源地址就是身份&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="p2">
          <mxGeometry x="20" y="50" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="q2" value="&lt;b&gt;按服务匹配&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;目的地址、端口、Host&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;条数只随服务增长&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="p2">
          <mxGeometry x="250" y="50" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="auto7" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1" target="q2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="q3" value="&lt;b&gt;查这台虚拟机的凭证&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;来源地址 × 服务&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;查不到就不带凭证&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="p2">
          <mxGeometry x="480" y="50" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="auto8" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2" target="q3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="q4" value="&lt;b&gt;注入并转发&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;覆盖虚拟机自带的&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;同名请求头&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="p2">
          <mxGeometry x="710" y="50" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="auto9" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q3" target="q4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ag" value="&lt;b&gt;本机凭证代理&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;内存里一张表：身份 × 服务 → 凭证&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;由控制面下发，凭证不写进 Envoy 配置&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontColor=#222222;" vertex="1" parent="p2">
          <mxGeometry x="420" y="180" width="260" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="auto10" value="查询" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q3" target="ag">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto11" value="客户端证书：改成一张证书加身份声明（2026-11-22 选定）&lt;br&gt;Egress 只出示自己的一张证书，条数不随虚拟机增长；&lt;br&gt;凭证代理给每个请求带一份签名的短期声明，写明是哪台&lt;br&gt;虚拟机。服务一侧核对证书、声明和来源地址。未验证。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p2">
          <mxGeometry x="20" y="170" width="360" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="auto12" value="Envoy 的外部授权过滤器&lt;br&gt;可以在放行时改写请求头，&lt;br&gt;实验第 4 期验证。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p2">
          <mxGeometry x="710" y="180" width="210" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="不走 HTTP 的口令：交给内网一侧的接入代理（2026-11-22 选定，未验证）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="940" height="186" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;虚拟机&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;照常连接，不带口令&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontColor=#222222;" vertex="1" parent="p3">
          <mxGeometry x="20" y="40" width="160" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;Egress&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;四层转发&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;可选：出示自己的证书&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="p3">
          <mxGeometry x="205" y="40" width="160" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auto13" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="d2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;网关&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;换成内网 IP，进隧道&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="p3">
          <mxGeometry x="390" y="40" width="160" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auto14" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="d3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;接入代理&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;按来源认出虚拟机&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;用它存的账号登录&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontColor=#222222;" vertex="1" parent="p3">
          <mxGeometry x="575" y="40" width="160" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auto15" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="d4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;数据库&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;只接受接入代理的连接&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontColor=#222222;" vertex="1" parent="p3">
          <mxGeometry x="760" y="40" width="160" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auto16" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="d5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auto17" value="口令放在接入代理上，虚拟机和 Egress 上都没有。数据库看到的来源变成接入代理的地址。&lt;br&gt;PostgreSQL 可以用 PgBouncer；MySQL 还没有确定可用的现成做法；Redis 的代理不能按虚拟机区分账号。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3">
          <mxGeometry x="20" y="122" width="900" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
