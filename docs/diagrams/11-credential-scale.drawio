<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="11-credential-scale" name="凭证：从逐台生成过滤链，到按身份查">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1" value="现在：每台虚拟机、每个服务端口各一条过滤链" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="940" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="l" value="&lt;b&gt;监听器&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;按来源地址、目的端口&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;逐级匹配&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#222222;" vertex="1" parent="p1">
          <mxGeometry x="20" y="65" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c0" value="&lt;b&gt;vm-a × 80&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontColor=#222222;" vertex="1" parent="p1">
          <mxGeometry x="230" y="40" width="96" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="auto1" value="" style="html=1;rounded=0;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="l" target="c0">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="115"/>
              <mxPoint x="220" y="126"/>
              <mxPoint x="298" y="126"/>
