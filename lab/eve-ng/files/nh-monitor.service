[Unit]
Description=Lab next-hop monitor (dataplane B)
After=lab-boot.service network.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/nh-monitor.py /etc/lab/nh-monitor.json
StandardOutput=append:/var/log/nh-monitor.log
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
