# 复制成 local.env 并按自己的环境填写。local.env 不进版本库。

# EVE-NG 主机的地址和登录用户。需要免密 SSH 登录，并且能免密 sudo。
EVE_HOST=192.0.2.10
EVE_USER=eve

# 可选：到 EVE 主机要经过的跳板机（~/.ssh/config 里的主机别名）。能直连就留空。
EVE_JUMP=

# 管理网地址的前三段（实验里 pnet0 所桥接的网段，按 /24 使用）。
# 节点的管理地址是它加上 nodes.json 里的 mgmt_host，例如 192.0.2.81。操作机要能直连这个网段。
MGMT_PREFIX=192.0.2
